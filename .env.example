# ==============================================================================
# DealFlow360 — Environment Configuration Reference (.env.example)
# ==============================================================================
# Copy this file to .env (or configure in your deployment orchestrator / appsettings).
# NEVER commit real production secrets, connection strings, or keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND CONFIGURATION (Vite / React 19)
# ------------------------------------------------------------------------------
# Target URL of the ASP.NET Core backend API used by the Vite dev server reverse proxy
VITE_API_BACKEND_URL=http://localhost:5042

# Local development port for the Vite dev server
PORT=3000

# ------------------------------------------------------------------------------
# 2. BACKEND CONFIGURATION (ASP.NET Core Web API / .NET 10)
# ------------------------------------------------------------------------------
# ASP.NET Core hosting environment (Development | Staging | Production)
ASPNETCORE_ENVIRONMENT=Development

# Host binding URLs (HTTP / HTTPS endpoints)
ASPNETCORE_URLS=http://localhost:5042

# Primary SQL Server Database Connection String
# For LocalDB: Server=(localdb)\mssqllocaldb;Database=DealFlow;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;
# For SQL Express / MSSQL: Server=localhost;Database=DealFlow;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;
ConnectionStrings__DefaultConnection="Server=localhost;Database=DealFlow;Integrated Security=True;TrustServerCertificate=True;MultipleActiveResultSets=True;"

# Set to true to fall back to EF Core In-Memory database if SQL Server is not available
UseInMemoryDatabase=false

# ------------------------------------------------------------------------------
# 3. JWT AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# Cryptographic secret key for signing HS256 JWT access tokens (minimum 32 characters)
Jwt__SecretKey=DealFlow360SuperSecretMasterKeyThatIsAtLeast32BytesLongForHS256Encryption!

# Token Issuer and Audience claims
Jwt__Issuer=DealFlow360API
Jwt__Audience=DealFlow360App

# Token expiration duration in minutes
Jwt__ExpiryMinutes=480
